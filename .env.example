NEARAI_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CHANNEL3_API_KEY=
PUBLIC_URL=http://localhost:8790

# Otari mode (Mozilla.ai's AI gateway). Setting OTARI_API_KEY switches every model call to Otari.
OTARI_API_KEY=
# EU accounts: https://eu.api.otari.ai/api/v1 (api.otari.ai answers 421 for an EU key)
OTARI_BASE_URL=https://eu.api.otari.ai/api/v1
# Optional: an Otari service key; each store is then billed as its own Otari end user with its own budget
OTARI_SERVICE_KEY=
OTARI_END_USER_BUDGET=
# Daily AI allowance per store, in USD, counted from the cost Otari reports on every call
MERCHANT_BUDGET_USD=0.25
# MCP server Otari connects the analyst to (defaults to PUBLIC_URL/mcp when PUBLIC_URL is a public https URL)
OTARI_MCP_URL=https://agent-shelf.onrender.com/mcp
# Secret path segment for the guardrail service Otari calls (PUBLIC_URL/guardrails/<token>/validate)
GUARDRAIL_TOKEN=
# Optional: lead any role with a routing policy made in the Otari dashboard, e.g. OTARI_POLICY_ANALYST=shelf-analyst
OTARI_POLICY_ANALYST=
